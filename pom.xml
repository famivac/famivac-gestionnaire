<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <artifactId>gestionnaire</artifactId>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.4.0</version>
            </plugin>
            <!-- Tests -->
<!--            <plugin>-->
<!--                <artifactId>maven-surefire-plugin</artifactId>-->
<!--                <dependencies>-->
<!--                    <dependency>-->
<!--                        <artifactId>junit-jupiter-engine</artifactId>-->
<!--                        <groupId>org.junit.jupiter</groupId>-->
<!--                        <version>5.13.4</version>-->
<!--                    </dependency>-->
<!--                </dependencies>-->
<!--                <groupId>org.apache.maven.plugins</groupId>-->
<!--                <version>3.5.3</version>-->
<!--            </plugin>-->
<!--            <plugin>-->
<!--                <artifactId>maven-failsafe-plugin</artifactId>-->
<!--                <configuration>-->
<!--                    <argLine>-->
<!--                        &#45;&#45;illegal-access=permit-->
<!--                    </argLine>-->
<!--                </configuration>-->
<!--                <groupId>org.apache.maven.plugins</groupId>-->
<!--                <version>3.5.3</version>-->
<!--            </plugin>-->
            <plugin>
                <artifactId>payara-micro-maven-plugin</artifactId>
                <configuration>
                    <commandLineOptions>
                        <option>
                            <key>--nocluster</key>
                        </option>
                    </commandLineOptions>
                    <javaCommandLineOptions>
                        <option>
                            <key>-Djavamelody.datasources</key>
                            <value>java:app/PostgreSQLDS</value>
                        </option>
                        <option>
                            <key>-Dhazelcast.jcache.provider.type</key>
                            <value>member</value>
                        </option>
                    </javaCommandLineOptions>
                    <payaraVersion>6.2025.7</payaraVersion>
                    <useUberJar>true</useUberJar>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                    </execution>
                </executions>
                <groupId>fish.payara.maven.plugins</groupId>
                <version>2.4</version>
            </plugin>
            <!-- Coveralls -->
            <plugin>
                <artifactId>coveralls-maven-plugin</artifactId>
                <groupId>org.eluder.coveralls</groupId>
                <version>4.3.0</version>
                <!-- Not needed, using Travis CI -->
                <!--
                <configuration>
                    <repoToken>yourcoverallsprojectrepositorytoken</repoToken>
                </configuration>
                -->
            </plugin>
            <plugin>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <id>default-prepare-agent</id>
                    </execution>
                    <execution>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <id>default-prepare-agent-integration</id>
                    </execution>
                    <execution>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <id>default-report</id>
                    </execution>
                    <execution>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                        <id>default-report-integration</id>
                    </execution>
                </executions>
                <groupId>org.jacoco</groupId>
                <version>0.8.13</version>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <!-- Jakarta EE dependencies -->
